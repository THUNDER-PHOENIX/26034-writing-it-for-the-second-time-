# Required for server-side OCR via OCR.space (free tier, no credit card).
# Sign up at https://ocr.space/ocrapi to get a key.
# Without this, the app silently falls back to in-browser Tesseract.js
# (slower and less accurate on real product photos).
OCR_SPACE_API_KEY=

# Optional: Supabase for cross-device persistence + image storage.
# When both are set, scans are saved to Supabase Postgres + Storage bucket
# instead of the browser's localStorage. When empty, localStorage is used.
# Create a project at https://supabase.com and run supabase/schema.sql in
# the SQL editor, then paste the values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
